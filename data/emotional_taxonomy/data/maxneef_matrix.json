  "schema_version": 1,
  "languages": ["en", "pl"],
  "structure_note": "9 axiological needs × 4 existential categories = 36 matrix cells. Each cell contains example satisfiers. NON-HIERARCHICAL by design (Max-Neef's explicit rejection of Maslow's hierarchy).",
